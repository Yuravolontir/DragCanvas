# Copy this file to .env and fill in real values.
# .env itself is git-ignored and must never be committed.

# ---------- Server ----------
PORT=3001
FRONTEND_URL=http://localhost:5173
# Public base URL of this server (used to build image-proxy links)
PUBLIC_API_URL=http://localhost:3001

# ---------- Database (PostgreSQL / Supabase) ----------
DATABASE_URL=postgresql://user:password@host:5432/postgres

# ---------- Authentication ----------
# Any long random string; it signs and verifies the JWT
JWT_SECRET=

# ---------- Cloudinary (file storage) ----------
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- AI ----------
# OpenRouter - used by POST /api/ai/generate (layout generation)
OPENROUTER_API_KEY=
AI_MODEL=google/gemini-2.5-flash
# Pexels - stock photos/videos that replace the AI placeholders
PEXELS_API_KEY=
# Stability AI - used by POST /api/ai/image (generated images for the layout).
# Server-side on purpose: see the warning in the frontend section below.
STABILITY_API_KEY=

# ---------- Mail delivery ----------
# Gmail: use an App Password, not the account password.
# Note: Gmail caps at ~500 messages/day and throttles bursts - fine for this
# project, but a real product would use SendGrid or Resend instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=DragCanvas <you@example.com>

# ---------- Publishing ----------
# Netlify personal access token - deploys the generated site
NETLIFY_TOKEN=

# ---------- Frontend ----------
# Vite substitutes VITE_* into the JavaScript at BUILD time, so every value here
# is downloaded in plain text by every visitor. Addresses are fine; a key is not.
# VITE_STABILITY_API_KEY and VITE_OPENROUTER_API_KEY used to live here and put
# working provider keys on the public site - both calls now go through the
# server, which holds STABILITY_API_KEY and OPENROUTER_API_KEY above.
# Nothing secret belongs below this line.
VITE_API_URL=http://localhost:3001
VITE_PY_API_URL=http://localhost:8000
# A genuinely published DragCanvas site. The landing page turns it into a QR
# code so a visitor can open it on their phone - pointing it back at this app
# makes the code scan and prove nothing.
VITE_EXAMPLE_SITE_URL=
