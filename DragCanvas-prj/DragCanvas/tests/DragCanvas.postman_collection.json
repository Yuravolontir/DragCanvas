    {
      "name": "8. Security checks",
      "item": [
        {
          "name": "No token (expect 401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users",
            "description": "verifyToken rejects the request before the controller runs.",
            "auth": {
