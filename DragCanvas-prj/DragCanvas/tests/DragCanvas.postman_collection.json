{
  "info": {
    "_postman_id": "bf8a3ddb-7293-4f19-972e-42d9f94a7f86",
    "name": "DragCanvas API",
    "description": "Express server for the DragCanvas website builder.\n\n1. Run 'Auth > Login' first - it stores the JWT into the {{token}} variable.\n2. Every other request inherits 'Bearer {{token}}' from the collection.\n3. Switch {{baseUrl}} between localhost and production in the Variables tab.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "description": "Password is hashed with bcrypt before it reaches the database.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"email\": \"testuser@example.com\",\n  \"password\": \"Test1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Login (saves token automatically)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "description": "The test script stores data.token into the {{token}} variable, so every other request is authenticated automatically.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"yuravolontir@gmail.com\",\n  \"password\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('login succeeded', function () { pm.response.to.have.status(200); });",
                  "if (body.success && body.data && body.data.token) {",
                  "    pm.collectionVariables.set('token', body.data.token);",
                  "    console.log('token saved: ' + body.data.token.length + ' chars');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - wrong password (expect 401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"yuravolontir@gmail.com\",\n  \"password\": \"wrong-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/logout",
            "description": "Protected: the user id comes from the token, not from the body.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionDurationMinutes\": 12\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
