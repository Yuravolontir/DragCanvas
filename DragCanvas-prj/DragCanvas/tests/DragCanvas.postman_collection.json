    {
      "name": "8. Security checks",
      "item": [
        {
          "name": "No token (expect 401)",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "description": "verifyToken rejects the request before the controller runs."
          }
        },
        {
          "name": "Invalid token (expect 401)",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "not-a-real-token",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "description": "The signature does not match, so jwt.verify throws."
          }
        },
        {
          "name": "Unknown route (expect 404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/nope",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "nope"
              ]
            },
            "description": "Handled by notFoundHandler."
          }
        }
