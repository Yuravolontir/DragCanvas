{
  "info": {
    "name": "DragCanvas API",
    "description": "Express server for the DragCanvas website builder.\n\nHow to use:\n1. Pick the environment: the {{baseUrl}} variable is set to http://localhost:3001. Change it to https://dragcanvas.onrender.com to hit production.\n2. Run 'Auth > Login' first - it stores the JWT into {{token}} automatically.\n3. Every other request sends 'Authorization: Bearer {{token}}' inherited from the collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Password is hashed with bcrypt before it reaches the database.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"email\": \"testuser@example.com\",\n  \"password\": \"Test1234\"\n}"
            }
          }
        },
        {
          "name": "Login (saves token automatically)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "On success the test script stores data.token into the {{token}} collection variable, so every other request is authenticated automatically.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"yuravolontir@gmail.com\",\n  \"password\": \"123456\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "",
                  "pm.test('login succeeded', () => pm.response.to.have.status(200));",
                  "",
                  "if (body.success && body.data && body.data.token) {",
                  "    pm.collectionVariables.set('token', body.data.token);",
                  "    console.log('token saved:', body.data.token.length, 'chars');",
                  "} else {",
                  "    console.log('no token in response');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - wrong password (expect 401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"yuravolontir@gmail.com\",\n  \"password\": \"wrong-password\"\n}"
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            },
            "description": "Protected: the user id comes from the token, not from the body.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionDurationMinutes\": 12\n}"
            }
          }
        }
      ]
    },
